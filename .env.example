# Copy to the profile's .env and fill in real values. DO NOT commit the real .env.
#   cp .env.example ~/.hermes/profiles/berghain/.env

# Bot token from @BotFather (create a bot with /newbot).
TELEGRAM_BOT_TOKEN=123456789:PUT-YOUR-BOTFATHER-TOKEN-HERE

# The single chat the digest is pushed to (this is a push-only bot — it posts
# only here, not to any chat it's added to). Private chat = positive id; group /
# supergroup = negative id (e.g. -1001234567890), and the bot must be a member.
# Find it by messaging the bot / posting in the group, then:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -oE '"chat":\{"id":-?[0-9]+'
TELEGRAM_HOME_CHANNEL=000000000
